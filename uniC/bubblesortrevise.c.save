#include <stdio.h>

int main() {
int arr[10] = {1,9,3,6,5,7,8,2,4,0};
const int size = 10;
for (int i = 0; i < size; i++) {
for(int k = 0; k < size;k++) {
printf("%d ",arr[k]);
}   for (int j = 0; j < size -i-1; j++) {
      if(arr[j] > arr[j+1]) {
        int temp = arr[j];
        arr[j] = arr[j+1];
        arr[j+1]=temp;
     }
   }
printf("\n");
 }
}
